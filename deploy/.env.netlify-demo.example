# Morph API env for pairing with the Netlify UI bundle (local-dev parity).
# Copy to deploy/.env.production (gitignored) or set on your host (Render, Docker, etc.).
# Do not commit real API keys.
#
# Netlify site: set MORPH_API_ORIGIN to this service’s public URL (no trailing slash).
# Netlify proxies /api/* to that origin (see scripts/netlify-build.sh).

MORPH_ENV=development

JWT_SECRET=morph-dev-jwt-secret-change-me
ADMIN_EMAIL=morphadmin@local.com
ADMIN_USERNAME=morphadmin
ADMIN_PASSWORD=admin123
JWT_EXPIRY_HOURS=876000

MORPH_AI_PROVIDER=dashscope
MORPH_AI_MODEL=qwen3-max
MORPH_AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MORPH_AI_API_KEY=

PORT=9090
DB_PATH=/data/badger
TRAN_SQLITE_PATH=/data/tran.sqlite
ENTITY_DETAILS_BADGER=/data/entity_details
MORPH_KNOWLEDGE_DIR=/data/knowledge
TRAN_ENTITY_ATTACHMENT_DIR=/data/uploads/entity_attachments

# CRA build arg when rebuilding the Morph image (public URL of this Netlify site).
# REACT_APP_MORPH_UTILS_URL=https://quiet-babka-faea1c.netlify.app
