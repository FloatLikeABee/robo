[Unit]
Description=UsersPanel API
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/robo
EnvironmentFile=-/etc/robo/env.production
Environment=HOST=0.0.0.0
Environment=PORT=5001
ExecStart=/opt/robo/bin/users-panel-api
Restart=on-failure
RestartSec=5
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
