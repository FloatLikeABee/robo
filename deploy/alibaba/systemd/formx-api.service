[Unit]
Description=FormsX API
After=network.target userspanel-api.service

[Service]
Type=simple
WorkingDirectory=/opt/robo
EnvironmentFile=-/etc/robo/env.production
Environment=SERVER_PORT=29909
Environment=UPLOAD_DIR=/var/lib/robo/formx-uploads
ExecStart=/opt/robo/bin/formsx-server
Restart=on-failure
RestartSec=5
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
