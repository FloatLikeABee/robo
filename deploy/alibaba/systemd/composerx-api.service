[Unit]
Description=ComposerX API
After=network.target userspanel-api.service

[Service]
Type=simple
WorkingDirectory=/opt/robo
EnvironmentFile=-/etc/robo/env.production
Environment=PORT=8043
Environment=TRAN_MONGO_DB=alterathena
Environment=TRAN_FILE_STORAGE_PATH=/var/lib/robo/composerx-storage
ExecStart=/opt/robo/bin/composerx-server
Restart=on-failure
RestartSec=5
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
