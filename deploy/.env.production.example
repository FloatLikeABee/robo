# Copy to deploy/.env.production (gitignored). Leave the secrets empty here.
# Production startup refuses the development defaults. Generate your own.
# Leave JWT_EXPIRY_HOURS unset (24 hours; allowed range is 1 through 168).

DORPH_ENV=production

# At least 32 unique random characters.
JWT_SECRET=

# At least 12 characters. Not admin123.
ADMIN_PASSWORD=

ADMIN_EMAIL=dorphadmin@local.com
ADMIN_USERNAME=dorphadmin

# Optional. The process starts without it; chat calls will fail until it is set.
# DORPH_AI_API_KEY=

# Optional build-time URL for the DorphUtils header link (CRA inlines it).
# Not read from this file at container runtime. The Blueprint lists
# REACT_APP_DORPH_UTILS_URL on dorph with sync: false and no value. Fill
# https://<dorph-utils public host> in the dashboard, then rebuild the image.
# Unset or loopback omits the link. Do not commit the URL.
