# Shared production environment template for Render / Alibaba.
# Copy to deploy/.env.production and fill secrets. DO NOT COMMIT secrets.
#
#   cp deploy/env.production.example deploy/.env.production
#   ./scripts/deploy.sh env check

# ── Public URLs ──────────────────────────────────────────────
USERS_PANEL_BASE_URL=https://panel-api.example.com
MORPH_PUBLIC_URL=https://morph.example.com
FORMSX_PUBLIC_URL=https://forms.example.com
COMPOSERX_PUBLIC_URL=https://mail.example.com
BOOKI_PUBLIC_URL=https://booki.example.com
SHARPREPORT_PUBLIC_URL=https://data.example.com
FRONTEND_ORIGIN=https://panel.example.com

# ── Auth (UsersPanel) ────────────────────────────────────────
JWT_SECRET=REPLACE_ME_WITH_LONG_RANDOM_STRING
HOST=0.0.0.0
PORT=5001
API_PUBLIC_URL=https://panel-api.example.com
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=

# ── MorphAI / DashScope (preferred on Alibaba) ───────────────
MORPH_AI_API_KEY=REPLACE_ME
MORPH_AI_MODEL=qwen3-max
MORPH_AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Optional embeddings (ComposerX / GraphRAG):
# TRAN_OPENAI_API_KEY=
# MORPH_GRAPH_EMBEDDING_MODEL=text-embedding-3-small

# ── Shared MySQL (tran) ──────────────────────────────────────
# Go apps:
TRAN_MYSQL_DSN=user:password@tcp(rm-xxxx.mysql.rds.aliyuncs.com:3306)/tran?parseTime=true&charset=utf8mb4
# Rust apps (UsersPanel / Engi):
DATABASE_URL=mysql://user:password@tcp(rm-xxxx.mysql.rds.aliyuncs.com:3306)/tran

# ── MongoDB ──────────────────────────────────────────────────
TRAN_MONGO_URI=mongodb://root:password@dds-xxxx.mongodb.rds.aliyuncs.com:3717/
TRAN_MONGO_DB=athena
# ComposerX uses alterathena (set in composerx service env):
# TRAN_MONGO_DB=alterathena

# ── Redis ────────────────────────────────────────────────────
TRAN_REDIS_ADDR=r-xxxx.redis.rds.aliyuncs.com:6379
# REDIS_HOST= / REDIS_PORT= for Booki-style configs

# ── Persistence paths (containers / ECS) ─────────────────────
DB_PATH=/data/badger
UPLOAD_DIR=/uploads
TRAN_FILE_STORAGE_PATH=/storage

# ── Morph satellite bases (public HTTPS of sibling APIs) ─────
TRANFORM_BASE_URL=https://forms-api.example.com
TRANMAIL_BASE_URL=https://mail-api.example.com
SHARPREPORT_BASE_URL=https://data-api.example.com
BOOKI_BASE_URL=https://booki-api.example.com

# ── GraphRAG (optional — see docs/MORPH_GRAPH_RAG_PLAN.md) ───
MORPH_GRAPH_ENABLED=false
# NEO4J_URI=neo4j://127.0.0.1:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=
# NEO4J_DATABASE=neo4j

# ── Booki ────────────────────────────────────────────────────
# DB_HOST= DB_PORT=3306 DB_USER= DB_PASSWORD= DB_NAME=tran
# APP_PORT=9095

# ── SharpReport ──────────────────────────────────────────────
# PORT=3050
# METABASE_*  — see SharpReport/.env.example
