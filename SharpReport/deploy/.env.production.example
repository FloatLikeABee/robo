# Copy to SharpReport/deploy/.env.production (gitignored). Do not commit values.
# GET /health succeeds when these are empty. Sign-in needs the Morph origin.

PORT=3050
SHARPREPORT_PORT=3050
SHARPREPORT_DATABASE_URL=sqlite:///data/datapulse.db
SHARPREPORT_UI_DIR=/app/ui

# Morph auth base URL. Not a secret. Example shape: https://<morph public host>
USERS_PANEL_BASE_URL=

# Encrypts stored database connection passwords. Leave empty until you set one.
JWT_SECRET=

# Optional. Data AI stays off until this is set.
MORPH_AI_API_KEY=
