# Server
PORT=3050
HOST=0.0.0.0
RUST_LOG=info

# Application Database
DATABASE_URL=sqlite://./data/datapulse.db
# Or for PostgreSQL:
# DATABASE_URL=postgresql://user:pass@localhost:5432/datapulse

# JWT
JWT_SECRET=your-super-secret-key-change-me
JWT_EXPIRY=24h

# Metabase (or use backend/config/*.toml — see [metabase] autostart to toggle embedded java -jar)
METABASE_JAR_PATH=./metabase/metabase.jar
METABASE_DOWNLOAD_URL=https://downloads.metabase.com/latest/metabase.jar
METABASE_PORT=8001
METABASE_HOST=127.0.0.1
METABASE_DB_TYPE=postgres
METABASE_DB_URL=postgresql://metabase:metabase-secret@localhost:5432/metabase
METABASE_JVM_OPTS=-Xmx2g -Xms512m

# Embedding
METABASE_SITE_URL=http://localhost:8001
METABASE_SECRET_KEY=your-metabase-secret-key

# CORS
ALLOWED_ORIGINS=http://localhost:5178,http://localhost:3050

# Frontend dev: Vite proxies /api/messages to UsersPanel (leave unset for same-origin).
# VITE_USERS_PANEL_API_URL=

# Platform auth (same UsersPanel as TranForm / TranMail — e.g. admin@local.com)
# Morph API hosts login/session (legacy env name kept)
USERS_PANEL_BASE_URL=http://127.0.0.1:9090

# MorphAI (DashScope — same model stack as Morph Data)
MORPH_AI_API_KEY=
MORPH_AI_MODEL=qwen3-max
# OpenAI-compatible provider (SiliconFlow, DashScope compatible-mode, etc.)

# Morph API (Knowledge Library / Neo4j GraphRAG indexing from DataX uploads)
# MORPH_API_BASE_URL=http://127.0.0.1:9090
# MORPH_AI_BASE_URL=https://api.siliconflow.cn/v1
# If page-build fails with "could not connect", check VPN/firewall or try DashScope:
# MORPH_AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DashScope native endpoint (only if MORPH_AI_BASE_URL is unset):
# MORPH_AI_API_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/text-generation/generation

# SMTP (Optional)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASSWORD=password