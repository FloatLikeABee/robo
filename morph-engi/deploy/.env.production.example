# Project production env. Copy beside this file under a gitignored name.
# Leave the values empty. Do not commit a filled copy.
#
# Public Morph API origin, no path. Not a secret.
USERS_PANEL_BASE_URL=
# Same value as Morph. At least 32 characters. Not the development default.
JWT_SECRET=
# Optional for /health. Required before AI project documents will run.
MORPH_AI_API_KEY=
