# Database — MySQL (recommended) or SQLite for zero-config local dev
# MySQL: mysql://user:pass@127.0.0.1:3306/morph_engi
# SQLite: sqlite://morph_engi.db
DATABASE_URL=sqlite://morph_engi.db

JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_EXPIRY_MIN=480

APP_ENV=development
APP_PORT=9096
CORS_ORIGIN=http://localhost:5179

# Morph Data auth (legacy env name USERS_PANEL_BASE_URL — same as Booki/FormsX/ComposerX)
USERS_PANEL_BASE_URL=http://127.0.0.1:9090

# MorphAI (DashScope)
MORPH_AI_API_KEY=
MORPH_AI_MODEL=qwen3-max
