# Database settings
CHROMA_PERSIST_DIRECTORY=./chroma_db

# Ollama settings
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_MODEL=qwen2.5-coder:7b

# Embedding settings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# HuggingFace SSL settings (set to false only if experiencing SSL errors - development only)
HF_SSL_VERIFY=true
HF_DOWNLOAD_TIMEOUT=300
# HuggingFace metadata (HEAD) requests use a separate 10s default unless ETAG timeout is set.
# rag_system sets HF_HUB_ETAG_TIMEOUT from HF_DOWNLOAD_TIMEOUT on startup.
# HuggingFace Mirror (optional - useful when huggingface.co is slow or blocked)
# HF_MIRROR=https://hf-mirror.com

# API settings
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true

# CORS settings (no "*" when credentials are enabled)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:3031","http://127.0.0.1:3031","http://localhost:3040","http://127.0.0.1:3040"]

# Email settings (optional)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Financial API settings (optional)
ALPHA_VANTAGE_API_KEY=your-api-key

# Qwen / Mistral (optional — same names as in Settings)
QWEN_API_KEY=
MISTRAL_API_KEY=

# Pollinations image API (optional Bearer — Graphic Document Generator / image download)
# Leave empty to call without Authorization; set if your network or Pollinations requires it.
POLLINATIONS_API_KEY=

# GLM / Z.ai (optional — for testing_alone.py and GLM callers)
GLM_API_KEY=

# Text-to-SQL default SQL Server (optional — used when no per-tool connection is set)
TEXT_TO_SQL_DEFAULT_HOST=
TEXT_TO_SQL_DEFAULT_PORT=1433
TEXT_TO_SQL_DEFAULT_DATABASE=
TEXT_TO_SQL_DEFAULT_USERNAME=
TEXT_TO_SQL_DEFAULT_PASSWORD=

# Groq API settings (optional)
# Set this in your local .env (do NOT commit real keys)
GROQ_API_KEY=your-groq-api-key
GROQ_DEFAULT_MODEL=llama-3.3-70b-versatile

# Optional Unicode fonts for ScholarForge PDF export (DejaVu Sans recommended on Linux):
# Place DejaVuSans.ttf and DejaVuSans-Bold.ttf in data/fonts/
# Each role can use a fully independent endpoint (API key + base URL + model).
# OpenAI-compatible hosts (SiliconFlow, DeepSeek, DashScope, etc.) need BASE_URL + API_KEY + MODEL.
#
# Example — SiliconFlow (China) for organizer + writer:
# SCHOLAR_FORGE_ORGANIZER_API_KEY=sk-...
# SCHOLAR_FORGE_ORGANIZER_BASE_URL=https://api.siliconflow.cn/v1
# SCHOLAR_FORGE_ORGANIZER_MODEL=deepseek-ai/DeepSeek-V3
# SCHOLAR_FORGE_WRITER_API_KEY=sk-...
# SCHOLAR_FORGE_WRITER_BASE_URL=https://api.siliconflow.cn/v1
# SCHOLAR_FORGE_WRITER_MODEL=Qwen/Qwen2.5-72B-Instruct
#
# Legacy fallback (uses global GEMINI/QWEN/GROQ keys when role API_KEY is empty):
SCHOLAR_FORGE_ORGANIZER_PROVIDER=gemini
SCHOLAR_FORGE_ORGANIZER_MODEL=gemini-2.5-flash
SCHOLAR_FORGE_ORGANIZER_API_KEY=
SCHOLAR_FORGE_ORGANIZER_BASE_URL=
SCHOLAR_FORGE_WRITER_PROVIDER=gemini
SCHOLAR_FORGE_WRITER_MODEL=gemini-2.5-flash
SCHOLAR_FORGE_WRITER_API_KEY=
SCHOLAR_FORGE_WRITER_BASE_URL=
# Image describer: vision model for figure placement hints
SCHOLAR_FORGE_IMAGE_PROVIDER=qwen
SCHOLAR_FORGE_IMAGE_MODEL=qwen-vl-ocr-2025-11-20
SCHOLAR_FORGE_IMAGE_API_KEY=
SCHOLAR_FORGE_IMAGE_BASE_URL=
SCHOLAR_FORGE_MIN_PROM_WORDS=100

# ScholarForge reviewer — critiques each paragraph; writer revises from the report
# Falls back to SCHOLAR_FORGE_ORGANIZER_* when unset
SCHOLAR_FORGE_REVIEWER_PROVIDER=gemini
SCHOLAR_FORGE_REVIEWER_MODEL=gemini-2.5-flash
SCHOLAR_FORGE_REVIEWER_API_KEY=
SCHOLAR_FORGE_REVIEWER_BASE_URL=
SCHOLAR_FORGE_MAX_REVIEW_ROUNDS=2
SCHOLAR_FORGE_REVIEW_PASS_SCORE=75

# Video Story Generator — three model roles (prompt polish, images, video)
# Prompt polisher: LLM for scene/character/scenery prompt completion
VIDEO_STORY_PROMPT_PROVIDER=gemini
VIDEO_STORY_PROMPT_MODEL=gemini-2.5-flash
VIDEO_STORY_PROMPT_API_KEY=
VIDEO_STORY_PROMPT_BASE_URL=
# Image generator: pollinations (default), siliconflow, or custom HTTP POST endpoint
VIDEO_STORY_IMAGE_PROVIDER=pollinations
VIDEO_STORY_IMAGE_MODEL=flux
VIDEO_STORY_IMAGE_API_KEY=
# Host, /v1, or full /images/generations URL all work for siliconflow.
VIDEO_STORY_IMAGE_BASE_URL=
#
# Example — SiliconFlow text-to-image (POST /v1/images/generations).
# VIDEO_STORY_IMAGE_PROVIDER=siliconflow
# VIDEO_STORY_IMAGE_MODEL=Kwai-Kolors/Kolors
# VIDEO_STORY_IMAGE_API_KEY=sk-...
# VIDEO_STORY_IMAGE_BASE_URL=https://api.siliconflow.cn/v1
# VIDEO_STORY_IMAGE_SIZE=1024x1024
# VIDEO_STORY_IMAGE_BATCH_SIZE=1
# VIDEO_STORY_IMAGE_NUM_INFERENCE_STEPS=20
# VIDEO_STORY_IMAGE_GUIDANCE_SCALE=7.5
# Video generator: pollinations | http (custom POST JSON/multipart → mp4) | siliconflow
VIDEO_STORY_VIDEO_PROVIDER=pollinations
VIDEO_STORY_VIDEO_MODEL=turbo
VIDEO_STORY_VIDEO_API_KEY=
# For provider=http: full endpoint URL. For provider=siliconflow: optional fallback image URL
# used as the reference frame when a scene has no locally generated image.
VIDEO_STORY_VIDEO_API_URL=
#
# Example — SiliconFlow video (async submit → poll status → download).
# With scene images: uses Wan-AI/Wan2.2-I2V-A14B + base64 image.
# Without scene images: auto-falls back to Wan-AI/Wan2.2-T2V-A14B.
# VIDEO_STORY_VIDEO_PROVIDER=siliconflow
# VIDEO_STORY_VIDEO_MODEL=Wan-AI/Wan2.2-I2V-A14B
# VIDEO_STORY_VIDEO_API_KEY=sk-...
# VIDEO_STORY_VIDEO_BASE_URL=https://api.siliconflow.cn/v1
# VIDEO_STORY_VIDEO_IMAGE_SIZE=1280x720
# VIDEO_STORY_VIDEO_NEGATIVE_PROMPT=
# VIDEO_STORY_VIDEO_SEED=0
# VIDEO_STORY_VIDEO_POLL_INTERVAL=5
# VIDEO_STORY_VIDEO_POLL_TIMEOUT=600
# Default clip length (seconds) when polishing short scene queries
# VIDEO_STORY_CLIP_SECONDS=5
# Scene-to-scene I2V continuity extracts the last frame of each clip via ffmpeg (must be on PATH).
# VIDEO_STORY_VIDEO_REQUEST_DELAY=3
# Retries per scene; SiliconFlow intermittently returns Failed with an empty reason
# VIDEO_STORY_VIDEO_MAX_ATTEMPTS=3
# Extra passes over still-failed scenes after a batch finishes
# VIDEO_STORY_VIDEO_RETRY_ROUNDS=2
# Provider: keep video prompts short (polish + submit hard-cap)
# VIDEO_STORY_VIDEO_PROMPT_MAX_WORDS=100
# Last-frame I2V continuity (PNG). If SiliconFlow rejects a frame, we fall back to cast/world.
# VIDEO_STORY_I2V_USE_LAST_FRAME=true
# VIDEO_STORY_CONTINUITY_HOLD_FRAMES=0
VIDEO_STORY_OUTPUT_DIR=video_stories