server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;

    location = /health {
        access_log off;
        default_type text/plain;
        return 200 'ok\n';
    }

    location = /ready {
        access_log off;
        default_type text/plain;
        return 200 'ok\n';
    }

    location = /config.js {
        add_header Cache-Control "no-store";
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
