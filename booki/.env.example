# Embedded SQLite (no MySQL required)
BOOKI_SQLITE_PATH=./data/booki.sqlite

JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_EXPIRY_MIN=15
JWT_REFRESH_EXPIRY_DAYS=7

APP_ENV=development
APP_PORT=9095
CORS_ORIGIN=http://localhost:5174

# MorphAI (DashScope — same model stack as Morph Data)
MORPH_AI_API_KEY=
MORPH_AI_MODEL=qwen3-max

# Staff messaging (UsersPanel)
USERS_PANEL_BASE_URL=http://127.0.0.1:5001
