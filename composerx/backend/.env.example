# ComposerX / Content Maker — embedded storage (no MySQL / Mongo / Redis)
PORT=8043
COMPOSERX_SQLITE_PATH=./data/composerx.sqlite
COMPOSERX_BADGER_PATH=./data/composerx_badger
TRAN_FILE_STORAGE_PATH=./storage
USERS_PANEL_BASE_URL=http://127.0.0.1:9090

# MorphAI (preferred — same as Morph Data)
MORPH_AI_API_KEY=
MORPH_AI_MODEL=qwen3-max
MORPH_AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

