# Local development — one file for every app.
# Copy to `.env` in this directory (never commit `.env`):
#   cp .env.example .env
# Existing per-app `.env` files are ignored. Merge them once with:
#   ./scripts/merge-local-env.sh
#
# Hosted Morph: docs/security-hosting-checklist.md (JWT_SECRET, ADMIN_PASSWORD, MORPH_ENV).
# Do not treat deploy/.env.production as a complete hosting runbook.
# Paths like ./data/... are relative to each app's working directory.
#
# Keys that used to collide (PORT, APP_PORT, SERVER_PORT, DATABASE_URL) have
# per-app names below. Apps still accept the old names as fallback.

# ── MorphAI (shared) ─────────────────────────────────────────
MORPH_AI_API_KEY=
MORPH_AI_MODEL=qwen3-max
MORPH_AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# MORPH_AI_API_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/text-generation/generation
# Named provider for every app that loads MorphAI from the environment. Example: MORPH_AI_PROVIDER=xai with XAI_API_KEY. Unset keeps DashScope. qwen3-max is not sent to other providers; set MORPH_AI_MODEL to that provider's model to override.
# MORPH_AI_PROVIDER=
# Named providers are optional. Unset, the unscoped client stays on MORPH_AI_* above.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# XAI_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# DASHSCOPE_API_KEY=
# MISTRAL_API_KEY=
# GROQ_API_KEY=
# OPENAI_COMPATIBLE_API_KEY=
# OPENAI_COMPATIBLE_BASE_URL=

# ── Auth (Morph hosts login; other apps point here) ──────────
# Local/dev only. Leave MORPH_ENV unset (or development / dev / local / test).
# ./start-all.sh does not set it. Hosting must set MORPH_ENV=production and
# replace the development values below. See docs/security-hosting-checklist.md.
# MORPH_ENV=development
USERS_PANEL_BASE_URL=http://127.0.0.1:9090
# Local signing key. Production refuses this value; use at least 32 random characters.
JWT_SECRET=morph-dev-jwt-secret-change-me
ADMIN_EMAIL=morphadmin@local.com
ADMIN_USERNAME=morphadmin
# Local bootstrap password. Production refuses this value; use at least 12 characters.
ADMIN_PASSWORD=admin123
# Local lifetime (~100 years). Production default is 24 when unset; allowed range is 1–168.
# Do not leave 876000 on a host. Example override: JWT_EXPIRY_HOURS=24
JWT_EXPIRY_HOURS=876000

# ── Morph (AI / Data) ────────────────────────────────────────
PORT=9090
DB_PATH=./data/badger
STORAGE_BACKEND=embedded
TRAN_SQLITE_PATH=./data/tran.sqlite
ENTITY_DETAILS_BADGER=./data/entity_details
EXTERNAL_API_BASE=http://localhost:8000
MORPH_GRAPH_ENABLED=false
MORPH_KNOWLEDGE_DIR=./data/knowledge
# REACT_APP_BK_URL=http://localhost:3000
# REACT_APP_MORPH_UTILS_URL=http://localhost:3040

# ── Event Logs / FormsX ──────────────────────────────────────
SERVER_PORT=29909
FORMSX_SQLITE_PATH=./data/formsx.sqlite
FORMSX_BADGER_PATH=./data/formsx_badger
UPLOAD_DIR=./uploads
# PUBLIC_FORM_BASE_URL=http://localhost:19909

# ── Content Maker / ComposerX ────────────────────────────────
COMPOSERX_PORT=8043
COMPOSERX_SQLITE_PATH=./data/composerx.sqlite
COMPOSERX_BADGER_PATH=./data/composerx_badger
TRAN_FILE_STORAGE_PATH=./storage
# VITE_API_BASE=

# ── Booki ────────────────────────────────────────────────────
BOOKI_SQLITE_PATH=./data/booki.sqlite
APP_ENV=development
APP_PORT=9095
CORS_ORIGIN=http://localhost:5174
JWT_ACCESS_EXPIRY_MIN=15
JWT_REFRESH_EXPIRY_DAYS=7
# VITE_API_BASE_URL=

# ── Project / Morph Engi ─────────────────────────────────────
MORPH_ENGI_DATABASE_URL=sqlite://morph_engi.db
MORPH_ENGI_PORT=9096
MORPH_ENGI_CORS_ORIGIN=http://localhost:5179
# MORPH_ENGI_JWT_ACCESS_EXPIRY_MIN=480

# ── Data Access / SharpReport ────────────────────────────────
# API bind port. Data Access Vite (5178) proxy + SSR fetch use this too (default 3050).
SHARPREPORT_PORT=3050
HOST=0.0.0.0
RUST_LOG=info
SHARPREPORT_DATABASE_URL=sqlite://./data/datapulse.db
ALLOWED_ORIGINS=http://localhost:5178,http://localhost:3050
METABASE_JAR_PATH=./metabase/metabase.jar
METABASE_PORT=8001
METABASE_HOST=127.0.0.1

# ── Academi ──────────────────────────────────────────────────
ACADEMI_SERVER_PORT=8978
SERVER_MODE=debug
AI_DEFAULT_PROVIDER=siliconflow
# SILICONFLOW_API_KEY=
# SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# ── BK / Ground Control ──────────────────────────────────────
# REACT_APP_API_URL=
# GEMINI_API_KEY=
