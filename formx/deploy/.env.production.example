# Copy to formx/deploy/.env.production (gitignored). Do not commit filled values.
# The image listens on PORT 29909. Leave PORT unset here so the image default is used.

# Public Morph origin. Not a secret. Hosted value: https://<morph public host>
USERS_PANEL_BASE_URL=

# Optional. The process starts without these.
MORPH_AI_API_KEY=
SMTP_PASSWORD=

# Public origin of this service, for links in broadcast mail.
# Hosted value: https://<event-logs public host>
PUBLIC_FORM_BASE_URL=
