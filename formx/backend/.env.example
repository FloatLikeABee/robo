# SheetX / FormsX — embedded storage (no MySQL / Mongo / Redis)
SERVER_PORT=29909
FORMSX_SQLITE_PATH=./data/formsx.sqlite
FORMSX_BADGER_PATH=./data/formsx_badger
UPLOAD_DIR=./uploads

# MorphAI — use SiliconFlow, DashScope compatible-mode, or native DashScope
MORPH_AI_API_KEY=
MORPH_AI_MODEL=qwen3-max
# OpenAI-compatible base URL (SiliconFlow, DashScope compatible-mode, etc.)
MORPH_AI_BASE_URL=https://api.siliconflow.cn/v1
# Optional: provider URL. OpenAI-compatible /v1 URLs (SiliconFlow) work here too.
# Native DashScope only: .../services/aigc/text-generation/generation
# MORPH_AI_API_URL=https://api.siliconflow.cn/v1

# Morph auth (JWT validation / shared session)
USERS_PANEL_BASE_URL=http://127.0.0.1:9090

# Optional: email broadcasts (net/smtp)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@example.com
# PUBLIC_FORM_BASE_URL=http://localhost:19909
